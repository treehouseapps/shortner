<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ttrim</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <div class="align-items">
                <img src="icon.png" alt="" width="50">
                <a class="navbar-brand" href="/">Ttrim</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item"><a class="nav-link" href="#">Home Page</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Sign Up</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Login</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <section class="search-bar">
        <div class="container">
        </div>
    </section>

    <div class="main">
        <form action="/short" method="post">
            <section class="form-container container">
                <div class="container d-flex justify-content-center my-5">
                    <div class="card shadow-lg p-4 card text-center">
                        <h2 class="card-title text-success font-weight-bold">URL Shortener</h2>
                        <input type="text" class="form-control mt-3 mb-4" name="link" value="https://www.google.com"
                            required>
                        <button class="btn btn-dark btn-block">Shorten</button>
                    </div>
                </div>
            </section>
        </form>
        <section class="form-container">
            <div class="container">
                <h3 class="text-center text-success">Shortened Links</h3>
                <div class="row justify-content-center">
                    <%result.forEach(ite=>{%>
                        <div class="col-lg-4 col-md-6 col-sm-12 mb-3">
                            <div class="box shadow-lg p-3 border rounded bg-white">
                                <p class="mb-2">Original URL: <a href="<%=ite.link%>" target="_blank">
                                        <%=ite.link%>
                                    </a></p>
                                <p>Shortened URL: <a href="<%=ite.newLink%>">
                                        <p id="text">
                                            <%=ite.newLink%>
                                        </p>
                                    </a></p>
                                <button class="btn btn-success btn-block mt-3" id="status" onclick="fun()">Copy</button>
                                <a href="/delete/<%=ite._id%>"><button
                                        class="btn btn-success btn-block mt-3">Delete</button></a>
                            </div>
                        </div>
                        <%})%>
                </div>
            </div>
        </section>

    </div>
    <footer>
        <p>&copy; 2025 Trehouseapps. All rights reserved.</p>
    </footer>
    <script src="script.js"></script>

</body>

</html>